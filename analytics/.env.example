# Analytics Service Configuration
PORT=4000
NODE_ENV=development

# Stellar Network & Soroban RPC
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
V1_CONTRACT_ID=CB7G2WZJ...
V2_CONTRACT_ID=CC8H3XAK...

# Indexer Configuration
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_BATCH_SIZE=100
START_LEDGER=0

# Storage & Database
ANALYTICS_DB_PATH=./data/analytics.json
DATABASE_URL=file:./data/analytics.db

# Data Retention Policy (in days, 0 = indefinite)
RETENTION_RAW_EVENTS_DAYS=90
RETENTION_HOURLY_ROLLUP_DAYS=365
RETENTION_DAILY_ROLLUP_DAYS=0

# CORS & Security
CORS_ORIGIN=*
