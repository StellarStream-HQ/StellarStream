{
  "name": "stellarstream-analytics",
  "version": "1.0.0",
  "description": "Contract Analytics Framework for StellarStream - Real-time event indexing, metrics processing, REST API, and visualization dashboard",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:indexer": "tsx watch src/indexer/service.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed-analytics.ts",
    "prune": "tsx src/scripts/run-retention.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "analytics",
    "metrics",
    "indexer",
    "tvl",
    "streaming"
  ],
  "author": "StellarStream Core Team",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
